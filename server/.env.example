MONGO_URI=mongodb://127.0.0.1:27017/acc-app
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
PORT=5000
# Local development values. In a deploy, CLIENT_URL is REQUIRED (the process
# refuses to boot without it) and must be the frontend origin exactly, with no
# trailing slash. Several origins may be comma-separated, e.g.:
#   CLIENT_URL=https://dukan-app-sable.vercel.app,https://dukan-sigma.vercel.app
CLIENT_URL=http://localhost:5173
SHARE_LINK_BASE_URL=http://localhost:5173
SHARE_LINK_TTL_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
